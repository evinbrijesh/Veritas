# VERITAS — Environment Variables
# Copy this file to `.env` and fill in real values before deploying.
# NEVER commit the actual .env file to git.

# --- Database credentials ---
# Used by Docker Compose to init Postgres and Neo4j on first run.
# POSTGRES_USER and POSTGRES_DB are hardcoded as 'veritas' in docker-compose.yml.
NEO4J_PASSWORD=change_this_to_something_strong
POSTGRES_PASSWORD=change_this_to_something_strong

# --- Auth / JWT ---
# JWT_SECRET_KEY: sign tokens with this. Generate with: openssl rand -hex 32
# JWT_ALGORITHM: must match what pyjwt expects (HS256 is standard).
# JWT_EXPIRE_MINUTES: token lifetime. 480 = 8hr shift, adjust per policy.
JWT_SECRET_KEY=generate_a_long_random_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- ML model paths ---
# SYNTHETIC_DETECTOR_MODEL_PATH: inside-container path to EfficientNet-B4 weights.
#   Weights are NOT shipped with the repo — add them to backend/app/ml/weights/
#   and the bind-mount makes them available at this path.
# LLM_MODEL_NAME: Ollama model tag. Pull it once after first docker compose up:
#   docker exec -it veritas-ollama ollama pull qwen2.5:7b
SYNTHETIC_DETECTOR_MODEL_PATH=/app/app/ml/weights/efficientnet_b4_synthetic.pt
LLM_MODEL_NAME=qwen2.5:7b

# --- Deployment identity ---
# Useful when multiple cyber cells run independent VERITAS instances.
# Appears in reports and audit logs to identify which deployment produced them.
DEPLOYMENT_NAME=cybercell_ernakulam
