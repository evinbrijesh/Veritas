# VERITAS — environment variables
# Copy to .env and fill in real values. Never commit the real .env file.

# --- Postgres (auth, cases, audit log) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=veritas
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://user:password@postgres:5432/veritas

# --- Neo4j (case graph) ---
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Redis (Celery broker/backend) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Ollama (local LLM) ---
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_SECRET_KEY=

# --- Auth / JWT ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# --- Celery / Flower ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=

# --- Storage (bind-mount paths, evidence must persist) ---
EVIDENCE_STORAGE_PATH=/data/evidence
NEO4J_DATA_PATH=/data/neo4j
NEO4J_BACKUP_PATH=/data/neo4j-backups
POSTGRES_DATA_PATH=/data/postgres

# --- Model weights ---
EFFICIENTNET_WEIGHTS_PATH=/models/efficientnet-b4-synthetic-detector.pt

# --- Misc ---
LOG_LEVEL=INFO
